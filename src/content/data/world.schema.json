{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Map id: \"connectivity\"."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What the map covers and its canon sources, for review."
    },
    "townSpawn": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The node a player enters the town at; reachability starts here."
    },
    "mainQuest": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Main-quest waypoints in order (bible §4.1); the critical path joins them."
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Node id, unique in the map, e.g. \"glen-well\"."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Place name exactly as the story bible spells it."
          },
          "area": {
            "type": "string",
            "enum": [
              "valley",
              "town",
              "briarwood",
              "moorings-watch",
              "deepworks",
              "priory",
              "knot",
              "river",
              "wendmouth"
            ],
            "description": "Region of the map the place belongs to."
          },
          "epic": {
            "type": "string",
            "enum": [
              "e24",
              "e25",
              "e26",
              "e40"
            ],
            "description": "Epic that builds the place (bead split: mw-e25 notes)."
          },
          "scene": {
            "description": "The scene file that holds the place. Omitted: planned, not yet built.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "scene"
          },
          "optional": {
            "default": false,
            "description": "The main quest never needs the place (Wendmouth, Kestrel Lock): AC-5 checks it.",
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "What the place is and which bible section names it."
          }
        },
        "required": [
          "id",
          "name",
          "area",
          "epic",
          "notes"
        ],
        "additionalProperties": false
      },
      "description": "Every place on the map."
    },
    "edges": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Edge id, unique in the map, e.g. \"glen-well-cistern\"."
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Node the edge leaves (the only end of a `one-way` edge you can enter)."
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Node the edge arrives at."
          },
          "kind": {
            "type": "string",
            "enum": [
              "path",
              "door",
              "shortcut",
              "one-way",
              "secret"
            ],
            "description": "Path, door, shortcut, one-way drop or secret."
          },
          "travel": {
            "default": "foot",
            "description": "How it is crossed: on foot or by barge.",
            "type": "string",
            "enum": [
              "foot",
              "barge"
            ]
          },
          "unlock": {
            "description": "World state that opens the edge, in the shared fact condition language (docs/design/conditions.md). Omitted: always open. Every shortcut needs one.",
            "$ref": "#/$defs/condition"
          },
          "routes": {
            "default": [],
            "description": "Capabilities that can open the edge, any one of them. Empty: anyone can (a quest or puzzle outcome, not a class ability).",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(verb|spell|arrow|tool|trick|technique|sense)\\.[a-z0-9.-]+$",
              "description": "Capability id declared in src/content/data/capability/, e.g. \"spell.mage-hand\"."
            }
          },
          "classesHint": {
            "default": [],
            "description": "The classes whose MVP capabilities include a route; must equal what the class files say (the validator derives it).",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "knight",
                "archer",
                "sorcerer",
                "thief"
              ]
            }
          },
          "time": {
            "description": "Clock phases (game.clock.phases) in which the edge can be taken, e.g. the barge.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "transitions": {
            "default": [],
            "description": "Built scene transitions that implement the edge (one per direction). Empty: planned.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([a-z0-9]+(?:-[a-z0-9]+)*)\\/([a-z0-9]+(?:-[a-z0-9]+)*)$"
            }
          },
          "bead": {
            "description": "Bead that builds the connection, set on every planned edge between two scenes.",
            "type": "string",
            "pattern": "^mw-[a-z0-9]+(?:\\.[0-9]+)*$"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "description": "What the connection is, and any bible canon for it."
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "notes"
        ],
        "additionalProperties": false
      },
      "description": "Every connection between two places."
    },
    "loops": {
      "default": [],
      "description": "The loops the story bible promises (§3.1).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Loop id, e.g. \"forest-watchtower-priory\"."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The loop as the bible words it (§3.1)."
          },
          "edges": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "Edge ids that form one cycle through the map."
          }
        },
        "required": [
          "id",
          "name",
          "edges"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "notes",
    "townSpawn",
    "mainQuest",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "A condition over world facts and live state: one of fact, count, entities, signal, sustained, all, any, not (docs/design/conditions.md).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "description": "Fact key to test. Alone: the (bool) fact is true. With one operator: that comparison holds."
            },
            "eq": {
              "description": "The fact equals this value.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "neq": {
              "description": "The fact does not equal this value (unset counts as unequal).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gt": {
              "description": "The (int or tick) fact is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The (int or tick) fact is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The (int or tick) fact is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The (int or tick) fact is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "has": {
              "description": "true: the fact holds a value (set, or declared with a non-null default); false: none.",
              "type": "boolean"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "Tests one fact, with at most one operator."
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "pattern": "^entity:([a-z0-9]+(?:-[a-z0-9]+)*|\\*)\\/\\*\\.([a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*)$",
              "description": "Entity facts to count: `entity:<level>/*.<fact>` (one level) or `entity:*/*.<fact>` (every level). Counts those holding true."
            },
            "eq": {
              "description": "The count equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The count does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The count is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The count is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The count is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The count is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "description": "Counts true entity facts matching a pattern, compared with exactly one operator."
        },
        {
          "type": "object",
          "properties": {
            "entities": {
              "type": "object",
              "properties": {
                "tag": {
                  "description": "Entities carrying this tag (an entity tag, or the tag of a scene spawn).",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "entity": {
                  "description": "The entity of the scene spawn with this id.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "additionalProperties": false,
              "description": "Which entities to test. `{ \"tag\": … }`, `{ \"entity\": … }` or both; `{}` is every entity with a placement."
            },
            "where": {
              "description": "Predicates (property, tag, element) an entity must all pass.",
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "property"
                      },
                      "property": {
                        "type": "string",
                        "enum": [
                          "material",
                          "temperature",
                          "flammable",
                          "ignitionPoint",
                          "fuel",
                          "burning",
                          "wetness",
                          "absorbency",
                          "frozen",
                          "freezePoint",
                          "conductive",
                          "charge",
                          "weight",
                          "fragile",
                          "hp",
                          "density",
                          "climbable",
                          "liftable",
                          "pushable",
                          "remoteActuatable",
                          "hideable",
                          "reflective",
                          "transparent",
                          "opaque",
                          "soundDamping",
                          "friction",
                          "impactAbsorb",
                          "owner",
                          "liquid",
                          "flammableGas",
                          "extinguishable",
                          "windResistance",
                          "flameRadius",
                          "waterSurface",
                          "unstable",
                          "suspended",
                          "support",
                          "breakable",
                          "bashable",
                          "cuttable",
                          "shootable",
                          "softAnchor",
                          "surfaceHardness",
                          "chargeActivated",
                          "lightActivated",
                          "hidden",
                          "trapped",
                          "trap",
                          "container",
                          "remains",
                          "noiseMultiplier"
                        ],
                        "description": "World property to compare (absent = its default)."
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "ne",
                          "lt",
                          "lte",
                          "gt",
                          "gte"
                        ],
                        "description": "Comparison; lt/lte/gt/gte need a number property."
                      },
                      "value": {
                        "description": "Value to compare with.",
                        "type": [
                          "number",
                          "boolean",
                          "string"
                        ]
                      }
                    },
                    "required": [
                      "test",
                      "property",
                      "op",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "tag"
                      },
                      "tag": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "description": "Tag the entity must carry, e.g. \"player\"."
                      }
                    },
                    "required": [
                      "test",
                      "tag"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "facing"
                      },
                      "facing": {
                        "type": "string",
                        "enum": [
                          "north",
                          "east",
                          "south",
                          "west"
                        ],
                        "description": "Compass direction its body faces: north is +z, east +x; a +90° turn takes north to east."
                      }
                    },
                    "required": [
                      "test",
                      "facing"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "element"
                      },
                      "element": {
                        "type": "string",
                        "enum": [
                          "fire",
                          "water",
                          "ice",
                          "charge"
                        ],
                        "description": "fire = burning, water = wetness > 0, ice = frozen, charge = charge > 0."
                      }
                    },
                    "required": [
                      "test",
                      "element"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "One condition; every condition of a filter must hold."
              }
            },
            "inside": {
              "description": "The entity must stand in this box, sphere or capsule, in world coordinates.",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "box",
                      "description": "Shape: an axis-aligned box."
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Centre of the box, metres."
                    },
                    "halfExtents": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Half the size per axis."
                    }
                  },
                  "required": [
                    "kind",
                    "center",
                    "halfExtents"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sphere",
                      "description": "Shape: a sphere."
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Centre of the sphere, metres."
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres."
                    }
                  },
                  "required": [
                    "kind",
                    "center",
                    "radius"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "capsule",
                      "description": "Shape: a capsule, a segment swept by a radius."
                    },
                    "from": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "One end of the capsule’s segment, metres."
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "The other end of the capsule’s segment, metres."
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres."
                    }
                  },
                  "required": [
                    "kind",
                    "from",
                    "to",
                    "radius"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "match": {
              "description": "all: at least one entity is selected and every one passes; any: one passes; none: none passes.",
              "type": "string",
              "enum": [
                "all",
                "any",
                "none"
              ]
            },
            "eq": {
              "description": "The number of entities that pass equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The number that pass does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The number that pass is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "At least this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "Fewer than this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "At most this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "entities"
          ],
          "additionalProperties": false,
          "description": "Property predicates over live entities: how many of them pass, and where they are. Exactly one of match or an operator."
        },
        {
          "type": "object",
          "properties": {
            "signal": {
              "type": "string",
              "pattern": "^([a-z0-9]+(?:-[a-z0-9]+)*)\\/([a-z0-9]+(?:-[a-z0-9]+)*)$",
              "description": "Signal graph id and node id, e.g. \"vault/gate-open\". Holds while the output is on."
            },
            "port": {
              "description": "Output port of the node; default: its first.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "signal"
          ],
          "additionalProperties": false,
          "description": "True while a signal graph node output is on (mark the node `observed`)."
        },
        {
          "type": "object",
          "properties": {
            "sustained": {
              "description": "The condition that must keep holding.",
              "$ref": "#/$defs/condition"
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "description": "Seconds of sim time it must hold, without a break."
            }
          },
          "required": [
            "sustained",
            "seconds"
          ],
          "additionalProperties": false,
          "description": "True once the condition has held, without a break, for that long."
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "Every condition holds."
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "True when every condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
