          },
          {
            "kind": "not",
            "condition": {
              "kind": "fact",
              "fact": "cray.theft-noted"
            }
          }
        ]
      },
      "node": "theft-1"
    },
    {
      "id": "thanks",
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "any",
            "of": [
              {
                "kind": "factCmp",
                "fact": "cray.disposition",
                "op": "eq",
                "value": "grateful"
              },
              {
                "kind": "factCmp",
                "fact": "cray.disposition",
                "op": "eq",
                "value": "fond"
              }
            ]
          },
          {
            "kind": "not",
            "condition": {
              "kind": "fact",
              "fact": "cray.thanked"
            }
          }
        ]
      },
      "node": "thanks-1"
    },
    {
      "id": "return",
      "when": {
        "kind": "dialogue.visitedCount",
        "id": "hub",
        "op": "gte",
        "value": 1
      },
      "node": "welcome-back"
    },
    {
      "id": "first-knight",
      "when": {
