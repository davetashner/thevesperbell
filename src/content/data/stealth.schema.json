{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique table id; the game reads \"stealth\"."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "Where the numbers come from (bead, tuning status)."
    },
    "visibility": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "curve": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Light level seen by the observer, 0–1 (after dark vision)."
                  },
                  "term": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2,
                    "description": "Light term at that level, 0–2."
                  }
                },
                "required": [
                  "level",
                  "term"
                ],
                "additionalProperties": false,
                "description": "One point of the light curve."
              },
              "description": "Light term by seen light level: points in rising level order, from level 0 to level 1."
            },
            "peakWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How the target’s light samples combine, 0–1: 0 = their mean, 1 = the brightest; a lit head on a body in shadow still shows."
            }
          },
          "required": [
            "curve",
            "peakWeight"
          ],
          "additionalProperties": false,
          "description": "Light term: the target’s light samples, combined, then lifted by the observer’s dark vision (seen = level + (1 − level) × darkVision, so dark vision 1 sees full light), read on the curve."
        },
        "stance": {
          "type": "object",
          "properties": {
            "prone": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Lying flat."
            },
            "crouched": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Crouched."
            },
            "standing": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Standing (1 = neutral)."
            }
          },
          "required": [
            "prone",
            "crouched",
            "standing"
          ],
          "additionalProperties": false,
          "description": "Stance term per stance, 0–2."
        },
        "motion": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fromSpeed": {
                "type": "number",
                "minimum": 0,
                "maximum": 50,
                "description": "Horizontal speed at which this band starts, m/s; the first band starts at 0."
              },
              "term": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "description": "Motion term in this band, 0–2."
              }
            },
            "required": [
              "fromSpeed",
              "term"
            ],
            "additionalProperties": false,
            "description": "One speed band."
          },
          "description": "Motion term by horizontal speed: bands in rising fromSpeed order; the fastest band the speed reaches applies."
        },
        "profile": {
          "type": "object",
          "properties": {
            "cloak": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Multiplier while a cloak or other concealing garment is worn."
            },
            "disguise": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Multiplier while disguised."
            }
          },
          "required": [
            "cloak",
            "disguise"
          ],
          "additionalProperties": false,
          "description": "Profile modifiers on top of the equipment brightness the target supplies (both multiply)."
        },
        "distance": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metres": {
                "type": "number",
                "minimum": 0,
                "maximum": 500,
                "description": "Observer-to-target distance, m."
              },
              "term": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "description": "Distance falloff at that distance, 0–2."
              }
            },
            "required": [
              "metres",
              "term"
            ],
            "additionalProperties": false,
            "description": "One point of the distance falloff curve."
          },
          "description": "Distance falloff: points in rising distance order from 0 m, never rising; flat past the last."
        },
        "contrast": {
          "type": "object",
          "properties": {
            "backgroundThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Background light at or above which a target is silhouetted against it, 0–1."
            },
            "darkTargetMax": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The target counts as dark (a silhouette) when its own combined light is at or below this, 0–1."
            },
            "bonus": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Added to a silhouetted target’s light term (capped at the full-light term), 0–2."
            }
          },
          "required": [
            "backgroundThreshold",
            "darkTargetMax",
            "bonus"
          ],
          "additionalProperties": false,
          "description": "Contrast rule: a dark figure against bright background light stands out."
        }
      },
      "required": [
        "light",
        "stance",
        "motion",
        "profile",
        "distance",
        "contrast"
      ],
      "additionalProperties": false,
      "description": "Visibility model weights (mw-e09.2)."
    },
    "noise": {
      "type": "object",
      "properties": {
        "audibleFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Global audibility floor, dB: below it a sound is not heard and propagation stops searching."
        },
        "doors": {
          "type": "object",
          "properties": {
            "open": {
              "type": "number",
              "minimum": -120,
              "maximum": 0,
              "description": "Gain through an open (or broken) door, dB (≤ 0)."
            },
            "ajar": {
              "type": "number",
              "minimum": -120,
              "maximum": 0,
              "description": "Gain through a door part-way open or moving, dB (≤ 0)."
            },
            "closed": {
              "type": "number",
              "minimum": -120,
              "maximum": 0,
              "description": "Gain through a closed door that muffles sound (`blocks.sound`), dB (≤ 0)."
            },
            "materials": {
              "default": [],
              "description": "Per leaf material overrides (iron muffles more than planks).",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "material": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Material id of the door leaf (a door profile’s `material`)."
                  },
                  "open": {
                    "description": "Gain while open, dB (≤ 0); omitted: the default.",
                    "type": "number",
                    "minimum": -120,
                    "maximum": 0
                  },
                  "ajar": {
                    "description": "Gain while ajar (moving or stopped part-way), dB (≤ 0).",
                    "type": "number",
                    "minimum": -120,
                    "maximum": 0
                  },
                  "closed": {
                    "description": "Gain while closed, dB (≤ 0).",
                    "type": "number",
                    "minimum": -120,
                    "maximum": 0
                  }
                },
                "required": [
                  "material"
                ],
                "additionalProperties": false,
                "description": "Door gains for one leaf material; unset states use the defaults."
              }
            }
          },
          "required": [
            "open",
            "ajar",
            "closed"
          ],
          "additionalProperties": false,
          "description": "Portal gains by door state; a closed door that does not block sound (a grille) counts as open. Gains must never rise from open to ajar to closed."
        },
        "partitions": {
          "type": "object",
          "properties": {
            "wall": {
              "type": "number",
              "minimum": -120,
              "maximum": 0,
              "description": "Default gain through a wall between side-by-side rooms, dB (≤ 0)."
            },
            "floor": {
              "type": "number",
              "minimum": -120,
              "maximum": 0,
              "description": "Default gain through a floor or ceiling between stacked rooms, dB (≤ 0)."
            },
            "materials": {
              "default": [],
              "description": "Per material overrides; a scene names a partition’s material.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "material": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Material id of the partition."
                  },
                  "wall": {
                    "description": "Gain through a wall of it, dB (≤ 0); omitted: the default.",
                    "type": "number",
                    "minimum": -120,
                    "maximum": 0
                  },
                  "floor": {
                    "description": "Gain through a floor or ceiling of it, dB (≤ 0); omitted: the default.",
                    "type": "number",
                    "minimum": -120,
                    "maximum": 0
                  }
                },
                "required": [
                  "material"
                ],
                "additionalProperties": false,
                "description": "Partition gains for one material; unset kinds use the defaults."
              }
            }
          },
          "required": [
            "wall",
            "floor"
          ],
          "additionalProperties": false,
          "description": "Transmission through walls and floors between adjacent rooms."
        },
        "impact": {
          "type": "object",
          "properties": {
            "minEnergy": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Least impact energy, J, that makes a noise: softer settling stays silent."
            },
            "refEnergy": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Energy, J, at which the curve reads `refDb`."
            },
            "refDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 120,
              "description": "Loudness, dB at 1 m, of a `refEnergy` impact on stone."
            },
            "dbPerDecade": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 40,
              "description": "dB gained for ten times the energy."
            },
            "maxDb": {
              "type": "number",
              "minimum": 0,
              "maximum": 120,
              "description": "Loudest an impact gets, dB at 1 m."
            }
          },
          "required": [
            "minEnergy",
            "refEnergy",
            "refDb",
            "dbPerDecade",
            "maxDb"
          ],
          "additionalProperties": false,
          "description": "Impact noise (mw-e03.25): loudness = refDb + dbPerDecade·log10(energy / refEnergy) plus the louder of the two materials’ surface loudness offsets, capped at maxDb; below minEnergy, silence."
        },
        "footsteps": {
          "type": "object",
          "properties": {
            "gaitDb": {
              "type": "object",
              "properties": {
                "sneak": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120,
                  "description": "Crouched or slow-walking step, dB at 1 m on stone (25)."
                },
                "walk": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120,
                  "description": "Walking step, dB at 1 m on stone (40)."
                },
                "run": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120,
                  "description": "Running step, dB at 1 m on stone (55)."
                },
                "sprint": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120,
                  "description": "Sprinting step, dB at 1 m on stone (65)."
                }
              },
              "required": [
                "sneak",
                "walk",
                "run",
                "sprint"
              ],
              "additionalProperties": false,
              "description": "Base loudness of one step by gait, before surface and equipment."
            },
            "creatureGait": {
              "type": "object",
              "properties": {
                "walkFrom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20,
                  "description": "Speed, m/s, at which a creature steps."
                },
                "runFrom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20,
                  "description": "Speed, m/s, a creature steps as a run."
                },
                "sprintFrom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30,
                  "description": "Speed, m/s, a creature steps as a sprint."
                },
                "stride": {
                  "type": "object",
                  "properties": {
                    "walk": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 5,
                      "description": "Metres between a walking creature’s steps."
                    },
                    "run": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 5,
                      "description": "Metres between a running creature’s steps."
                    },
                    "sprint": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 5,
                      "description": "Metres between a sprinting creature’s steps."
                    }
                  },
                  "required": [
                    "walk",
                    "run",
                    "sprint"
                  ],
                  "additionalProperties": false,
                  "description": "Ground distance between steps per gait (the player’s: 0.75, 1.6, 2.05)."
                }
              },
              "required": [
                "walkFrom",
                "runFrom",
                "sprintFrom",
                "stride"
              ],
              "additionalProperties": false,
              "description": "A creature has no controller: its gait is read from the speed it moves at (patrols walk, chases run)."
            },
            "landing": {
              "type": "object",
              "properties": {
                "minHeight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "description": "Fall height, m, below which a landing is just a step: silent."
                },
                "curve": {
                  "minItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "height": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Fall height, m."
                      },
                      "db": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 120,
                        "description": "Loudness, dB at 1 m on stone, of a landing from it."
                      }
                    },
                    "required": [
                      "height",
                      "db"
                    ],
                    "additionalProperties": false
                  },
                  "description": "Piecewise-linear loudness by fall height, flat beyond its ends."
                }
              },
              "required": [
                "minHeight",
                "curve"
              ],
              "additionalProperties": false,
              "description": "Landing impulse by fall height (the height whose free fall reaches the speed)."
            }
          },
          "required": [
            "gaitDb",
            "creatureGait",
            "landing"
          ],
          "additionalProperties": false,
          "description": "Footstep noise (mw-e09.5): loudness = gait dB + the surface’s offset + the wearer’s equipment dB (20·log10 of the noise multiplier, ADR-0003) + a creak when the board has one."
        }
      },
      "required": [
        "audibleFloor",
        "doors",
        "partitions",
        "impact",
        "footsteps"
      ],
      "additionalProperties": false,
      "description": "Sound propagation (mw-e09.3): a noise loses 20·log10(d) dB over a path of d metres (none within 1 m) plus the gain of every door, wall and floor it passes."
    }
  },
  "required": [
    "id",
    "notes",
    "visibility",
    "noise"
  ],
  "additionalProperties": false
}
