{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Id of the quest; stable forever (saves track its state)."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The quest’s name in the journal."
    },
    "titleKey": {
      "description": "Localization key for the text. Default: `quest.<quest id>.<part>[.<id>]`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "What the quest is about, as the journal first tells it."
    },
    "summaryKey": {
      "description": "Localization key for the text. Default: `quest.<quest id>.<part>[.<id>]`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "notes": {
      "description": "What the quest is for, for writers.",
      "type": "string",
      "minLength": 1
    },
    "givers": {
      "description": "NPCs who hand the quest out (the journal and map point at them).",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "x-contentRef": "creature"
      }
    },
    "startWhen": {
      "description": "Condition (logic DSL) that starts the quest. Omit: it is started by an effect.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "The logic kind, e.g. \"hasItem\"."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": {}
    },
    "stages": {
      "default": [],
      "description": "Optional sequencing, in order. The quest begins in `initialStage`.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Id of the stage, unique in the quest."
          },
          "text": {
            "description": "Journal text while the quest is in this stage.",
            "type": "string",
            "minLength": 1
          },
          "textKey": {
            "description": "Localization key for the text. Default: `quest.<quest id>.<part>[.<id>]`.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "transitions": {
            "default": [],
            "description": "Moves out of this stage, evaluated while it is current (branching quests: the first condition that holds picks the next stage).",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The logic kind, e.g. \"hasItem\"."
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": {},
                  "description": "Condition (logic DSL) that moves the quest on. The first to hold, in file order, wins."
                },
                "stage": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "description": "The stage the quest moves to."
                },
                "effects": {
                  "description": "Effects applied in the same atomic batch as the move (e.g. set a fact).",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The logic kind, e.g. \"hasItem\"."
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": {},
                    "description": "A logic DSL node: an object with a `kind` and that kind’s fields."
                  }
                },
                "note": {
                  "description": "A note for writers; never shown to players.",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "when",
                "stage"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "description": "A note for writers; never shown to players.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "initialStage": {
      "description": "The stage the quest starts in. Default: the first stage.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "objectives": {
      "description": "What the quest tracks.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id of the objective, unique in the quest; other logic names it."
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "The journal line, e.g. \"Find out who has been taking the books.\""
              },
              "textKey": {
                "description": "Localization key for the text. Default: `quest.<quest id>.<part>[.<id>]`.",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "optional": {
                "default": false,
                "description": "Not needed to resolve; a bonus or a side thread.",
                "type": "boolean"
              },
              "hidden": {
                "default": false,
                "description": "Not shown until complete (a surprise).",
                "type": "boolean"
              },
              "activeWhen": {
                "description": "Condition (logic DSL) from which the objective is active. Omit: with its stage.",
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The logic kind, e.g. \"hasItem\"."
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": {}
              },
              "stage": {
                "description": "Active only in this stage. Omit: in every stage.",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "note": {
                "description": "A note for writers; never shown to players.",
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "haveItem",
                "description": "The player holds the item. Completes while held and reverts when it is lost, unless `latch`."
              },
              "params": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "x-contentRef": "item"
                  },
                  "count": {
                    "default": 1,
                    "description": "How many.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "latch": {
                    "default": false,
                    "description": "Stay complete once reached, even if the item is later dropped or spent.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "item"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "params"
            ],
            "additionalProperties": false
          },
