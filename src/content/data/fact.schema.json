{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Group id, e.g. \"endings\". Facts are keyed by `key`, not by this."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name (docs and debug tools)."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What these facts cover and where they come from (canon section), for review."
    },
    "facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Fact key, or an `entity:*.<fact>` template for a fact every entity can hold."
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "What the fact records, when it changes and what reads it (designers, owner review)."
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "System that writes the fact, e.g. \"signals\", \"quest\", \"interaction\"."
              },
              "renamedFrom": {
                "description": "Keys this fact was saved under before (any older spelling; for a template, older templates). A save holding one loads into this key with its value (mw-e27.4); never remove an entry once a build shipped it.",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "persistence": {
                "default": "permanent",
                "description": "How long a written value lasts: `permanent` (default) keeps it in saves forever; `reset-on-rest` returns it to its default when the player rests; `reset-after` (with `resetAfter`) returns it that many sim ticks after it was last written, loaded or not; `transient` is never saved; `decays-to` (with `decaysTo`) loads one of its values as another (a burning thing as burnt).",
                "type": "string",
                "enum": [
                  "permanent",
                  "reset-on-rest",
                  "reset-after",
                  "transient",
                  "decays-to"
                ]
              },
              "resetAfter": {
                "description": "Sim ticks after the last write at which the fact returns to its default; only with persistence `reset-after`, where it is required.",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "decaysTo": {
                "description": "Only with persistence `decays-to`, where it is required.",
                "type": "object",
                "properties": {
                  "from": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      ]
                    },
                    "description": "Saved values that decay (e.g. [\"burning\"])."
                  },
                  "to": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    ],
                    "description": "The value a loaded game holds instead (e.g. \"burnt\")."
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "type": {
                "type": "string",
                "const": "bool",
                "description": "A true/false flag."
              },
              "default": {
                "type": "boolean",
                "description": "Value read before the fact is first written."
              }
            },
            "required": [
              "key",
              "description",
              "owner",
              "type",
              "default"
            ],
            "additionalProperties": false
          },
