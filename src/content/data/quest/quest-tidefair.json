{
  "$schema": "../quest.schema.json",
  "id": "quest-tidefair",
  "title": "The Tidefair",
  "summary": "Every market day the Stone Wharf holds the Tidefair: arm-wrestling at the Drowned Gull, the Gull Shoot, the Regatta and the Pocket Race. Any class may enter any event, and each class is best at one. Win honestly, cheat, throw a match for Nell's book, or lose gracefully; the Gull warms to you either way.",
  "notes": "Side quest of Wendmouth (bible 3.6, 6.1 quest 7; mw-e39.22), optional to the main quest: it reads and writes only harbour facts. Each event writes tidefair.results.<event> (won, lost, cheated, thrown) from its contest outcome effects: the arm-wrestling contest does so now (drowned-gull-arm-wrestling); the gull shoot, regatta and pocket race are mw-e40.7 to mw-e40.9 and write the same facts when built, so their objectives are fact objectives that stay open until then. The class event is highlighted (tidefair.highlight) but every event stays enterable. A regatta win with magic while Cray walks the quay is voided in the stage transition (tidefair.cheated, a fine branch in cray-customs). The quest resolves once the player calls the day (Oona) or has a result in all four events: a class champion, an honest winner, a crooked winner, a bookie's friend, or a graceful loser (consolation, dispositions never lower). Placeholder numbers (the fine, the purse) are for the owner to tune.",
  "givers": ["npc-oona", "npc-nell"],
  "startWhen": {
    "kind": "any",
    "of": [
      {
        "kind": "fact",
        "fact": "tidefair.joined"
      },
      {
        "kind": "fact",
        "fact": "nell.gull-shoot-sponsored"
      },
      {
        "kind": "fact",
        "fact": "nell.book-open"
      }
    ]
  },
  "stages": [
    {
      "id": "entry",
      "text": "The Tidefair runs on market day on the Stone Wharf: four events, any of them open to you, and a prize for each. Big Oona takes entries at the Drowned Gull and Nell keeps the book.",
      "transitions": [
        {
          "when": {
            "kind": "playerClass",
            "class": "knight"
          },
          "stage": "events",
          "effects": [
            {
              "kind": "setFact",
              "fact": "tidefair.highlight",
              "value": "arm-wrestling"
            }
          ]
        },
        {
          "when": {
            "kind": "playerClass",
            "class": "archer"
          },
          "stage": "events",
          "effects": [
            {
              "kind": "setFact",
              "fact": "tidefair.highlight",
              "value": "gull-shoot"
            }
          ]
        },
        {
          "when": {
            "kind": "playerClass",
            "class": "sorcerer"
          },
          "stage": "events",
          "effects": [
            {
              "kind": "setFact",
              "fact": "tidefair.highlight",
              "value": "regatta"
            }
          ]
        },
        {
          "when": {
            "kind": "playerClass",
            "class": "thief"
          },
          "stage": "events",
          "effects": [
            {
              "kind": "setFact",
              "fact": "tidefair.highlight",
              "value": "pocket-race"
            }
          ]
        },
        {
          "when": {
            "kind": "not",
            "condition": {
              "kind": "any",
              "of": [
                {
                  "kind": "playerClass",
                  "class": "knight"
                },
                {
                  "kind": "playerClass",
                  "class": "archer"
                },
                {
                  "kind": "playerClass",
                  "class": "sorcerer"
                },
                {
                  "kind": "playerClass",
                  "class": "thief"
                }
              ]
            }
          },
          "stage": "events"
        }
      ]
    },
    {
      "id": "events",
      "text": "Four events: arm-wrestling at the Drowned Gull, the Gull Shoot on the boom, the Regatta in the pool and the Pocket Race in the crowd. Your own class has an event it was made for, but nobody checks your hands at the door.",
      "transitions": [
        {
          "when": {
            "kind": "all",
            "of": [
              {
                "kind": "factCmp",
                "fact": "tidefair.results.regatta",
                "op": "eq",
                "value": "won"
              },
              {
                "kind": "fact",
                "fact": "tidefair.regatta.magic-used"
              },
              {
                "kind": "fact",
                "fact": "tidefair.regatta.cray-present"
              }
            ]
          },
          "stage": "fined",
          "effects": [
            {
              "kind": "setFact",
              "fact": "tidefair.results.regatta",
              "value": "cheated"
            },
            {
              "kind": "setFact",
              "fact": "tidefair.cheated",
              "value": true
            },
            {
              "kind": "setFact",
              "fact": "tidefair.regatta.fine-due",
              "value": true
            },
            {
              "kind": "disposition",
              "npc": "npc-oona",
              "delta": -1
            },
            {
              "kind": "emit",
              "event": "regatta-win-voided"
            }
          ]
        }
      ]
    },
    {
      "id": "fined",
      "text": "The Regatta win is void: you used magic in front of Inspector Cray, and rule four is the one rule she enforces. She will want ten crowns, or an entry in her ledger.",
      "transitions": [
        {
          "when": {
            "kind": "any",
            "of": [
              {
                "kind": "fact",
                "fact": "tidefair.regatta.fine-paid"
              },
              {
                "kind": "fact",
                "fact": "tidefair.regatta.fine-owed"
              }
            ]
          },
          "stage": "after-the-fine"
        }
      ]
    },
    {
      "id": "after-the-fine",
      "text": "The fine is settled, or at least written down. The other events are still open to you, and the harbour is watching a little more closely."
    }
  ],
  "initialStage": "entry",
  "objectives": [
    {
      "id": "see-the-flagstones",
      "kind": "enterArea",
      "text": "Walk out to the Tidefair ground on the Stone Wharf flagstones.",
      "params": {
        "area": "tidefair-ground"
      },
      "optional": true
    },
    {
      "id": "sign-up",
      "kind": "fact",
