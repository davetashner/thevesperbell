        "fact": "tidefair.results.gull-shoot",
        "value": "won"
      },
      "optional": true
    },
    {
      "id": "win-the-regatta",
      "kind": "fact",
      "text": "Win the Regatta. Rule four says no magic; mind who is walking the quay.",
      "params": {
        "fact": "tidefair.results.regatta",
        "value": "won"
      },
      "optional": true
    },
    {
      "id": "win-the-pocket-race",
      "kind": "fact",
      "text": "Win the Pocket Race: five ribbons from five marks, and one of them is the Inspector.",
      "params": {
        "fact": "tidefair.results.pocket-race",
        "value": "won"
      },
      "optional": true
    },
    {
      "id": "lift-crays-ribbon",
      "kind": "fact",
      "text": "Lift Inspector Cray's ribbon without her feeling it.",
      "params": {
        "fact": "tidefair.pocket.cray-lifted"
      },
      "optional": true
    },
    {
      "id": "settle-the-fine",
      "kind": "talkTo",
      "text": "Settle the regatta fine with Inspector Cray.",
      "params": {
        "npc": "npc-cray"
      },
      "optional": true,
      "stage": "fined"
    }
  ],
