{
  "$schema": "../quest.schema.json",
  "id": "quest-briar-glen-epilogue",
  "title": "What Became of Briar Glen",
  "summary": "The valley's story, told in the slides the ending leaves behind.",
  "notes": "The epilogue-slide variants of the four headline endings (bible 4.4), as data. Started when the main quest resolves. Each slide is an objective whose `activeWhen` is its selection rule, so while this quest is active the set of active objectives IS the slide list (read it with QuestRuntime.activeObjectives); the slideshow completes each slide by emitting epilogue-slide-<id>, and sets epilogue.finished to close the quest. Slide text here is a description for the writers; the slide prose is mw-e39.16. Harbour slides (name-stone home, the Tern's crate) are added by facts alone and never change the headline ending.",
  "startWhen": {
    "kind": "questState",
    "quest": "quest-labyrinth-beneath-briar-glen",
    "state": "resolved"
  },
  "objectives": [
    {
      "id": "vr-bell-goblins",
      "kind": "event",
      "text": "The goblins ring the bell at dusk.",
      "params": {
        "event": "epilogue-slide-vr-bell-goblins"
      },
      "activeWhen": {
        "kind": "all",
        "of": [
          {
            "kind": "factCmp",
            "fact": "ending.headline",
            "op": "eq",
            "value": "vespers-rung"
          },
