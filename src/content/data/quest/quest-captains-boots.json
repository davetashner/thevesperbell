            "kind": "factCmp",
            "fact": "boots.method",
            "op": "eq",
            "value": "tied"
          },
          {
            "kind": "any",
            "of": [
              {
                "kind": "fact",
                "fact": "hale.secret.kept"
              },
              {
                "kind": "fact",
                "fact": "hale.secret.exposed"
              }
            ]
          }
        ]
