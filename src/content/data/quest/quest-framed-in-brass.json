            "fact": "framed.method",
            "op": "eq",
            "value": "force"
          },
          {
            "kind": "any",
            "of": [
              {
                "kind": "fact",
                "fact": "vane.exposed"
              },
              {
                "kind": "factCmp",
                "fact": "vane.fate",
                "op": "eq",
                "value": "bribed-player"
              },
              {
                "kind": "factCmp",
                "fact": "vane.fate",
                "op": "eq",
                "value": "fled"
              }
            ]
          }
        ]
      },
      "priority": 0,
      "effects": [
        {
          "kind": "emit",
          "event": "framed-resolved",
          "data": {
            "method": "force"
          }
        }
      ],
      "journal": "You broke the crate open and half the clan with it. Duggan Marl is out and the goblins hate you, but the proof was good and Vane has had to answer for the brass."
    },
    {
