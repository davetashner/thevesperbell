            "fact": "framed.method",
            "op": "eq",
            "value": "trade"
          },
          {
            "kind": "any",
            "of": [
              {
                "kind": "fact",
                "fact": "vane.exposed"
              },
              {
                "kind": "factCmp",
                "fact": "vane.fate",
                "op": "eq",
                "value": "bribed-player"
              },
              {
                "kind": "factCmp",
                "fact": "vane.fate",
                "op": "eq",
                "value": "fled"
              }
            ]
          }
        ]
      },
      "priority": 0,
