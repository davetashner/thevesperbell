        {
          "kind": "emit",
          "event": "bones-resolved",
          "data": {
            "outcome": "joins-you"
          }
        }
      ],
      "journal": "Brother Anselm Hobb walks beside you now, and trips over things less often than he used to. He wants to see Corvin. He has a great deal to say, and a very long walk to say it in."
    },
    {
      "id": "rest-with-rites",
