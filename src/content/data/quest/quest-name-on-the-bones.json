{
  "$schema": "../quest.schema.json",
  "id": "quest-name-on-the-bones",
  "title": "The Name on the Bones",
  "summary": "Clatter cannot remember his own name. A psalter, a pear tree and a letter might help him.",
  "notes": "Side quest of the town and the Knot (bible 6.1 quest 5; mw-e39.11), any class, the emotional one. Started by meeting Clatter (clatter.met), finding the psalter (evidence.clatter-psalter), the Bible (hollis.bible-lent) or the pear (bones.pear-bloomed). Three pieces, any order, each handed to Clatter in clatter-garden, which moves clatter.memories up one: the psalter (a readable among the Forgotten in the Ossuary), the pear tree (Juniper's graft, bones.pear-bloomed) and his sister's letter (Hollis lends the Bible, or a thief takes it). A sorcerer's memory-reading skips a piece when it succeeds; when it fails it costs a memory and permanently lowers clatter.memories.max from 3 to 2 (bible 6.1), and the quest then moves to lost-one and is completed by any two pieces. When clatter.memories reaches the max the quest sets clatter.restored and tansy.kin.known (Tansy is family: the epilogue slide vr-clatter-name). The choice is then Clatter's: join you (clatter.fate joined, which enables the abbot's Persuade resolution; the bead's clatter.choice is this existing fact) or rest (clatter.fate rested), with the knight's rites (clatter.rites) or the psalter laid on the priory altar; the three resolutions. The placed pear tree and its bloom are E29; the altar is narrated.",
  "givers": ["npc-clatter"],
  "startWhen": {
    "kind": "any",
    "of": [
      {
        "kind": "fact",
        "fact": "clatter.met"
      },
      {
        "kind": "fact",
        "fact": "evidence.clatter-psalter"
      },
      {
        "kind": "fact",
        "fact": "hollis.bible-lent"
      },
      {
        "kind": "fact",
        "fact": "bones.pear-bloomed"
      }
    ]
  },
  "stages": [
    {
      "id": "gather",
      "text": "Clatter half remembers three things: a psalter among the Forgotten, a pear tree in the priory garden and a letter from his sister. Bring them to him in any order.",
      "transitions": [
        {
          "when": {
            "kind": "any",
            "of": [
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories.max",
                    "op": "eq",
                    "value": 3
                  },
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories",
                    "op": "gte",
                    "value": 3
                  }
                ]
              },
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories.max",
                    "op": "eq",
                    "value": 2
                  },
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories",
                    "op": "gte",
                    "value": 2
                  }
                ]
              }
            ]
          },
          "stage": "remembered",
          "effects": [
            {
              "kind": "setFact",
              "fact": "clatter.restored",
              "value": true
            },
            {
              "kind": "setFact",
              "fact": "tansy.kin.known",
              "value": true
            }
          ]
        },
        {
          "when": {
            "kind": "factCmp",
            "fact": "clatter.memories.max",
            "op": "eq",
            "value": 2
          },
          "stage": "lost-one"
        }
      ]
    },
    {
      "id": "lost-one",
      "text": "A memory has gone for good, and it will not come back. Two of the three pieces will have to be enough.",
      "transitions": [
        {
          "when": {
            "kind": "any",
            "of": [
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories.max",
                    "op": "eq",
                    "value": 3
                  },
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories",
                    "op": "gte",
                    "value": 3
                  }
                ]
              },
              {
                "kind": "all",
                "of": [
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories.max",
                    "op": "eq",
                    "value": 2
                  },
                  {
                    "kind": "factCmp",
                    "fact": "clatter.memories",
                    "op": "gte",
                    "value": 2
                  }
                ]
              }
            ]
          },
          "stage": "remembered",
          "effects": [
            {
              "kind": "setFact",
              "fact": "clatter.restored",
              "value": true
            },
            {
              "kind": "setFact",
              "fact": "tansy.kin.known",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "remembered",
      "text": "Brother Anselm Hobb has his name. He asks whether it is time to rest, or whether there is something yet for hands like his to do."
    }
  ],
  "initialStage": "gather",
  "objectives": [
    {
