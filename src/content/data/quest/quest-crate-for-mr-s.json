        {
          "when": {
            "kind": "any",
            "of": [
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "case-the-warehouse",
                "state": "complete"
              },
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "visit-the-undertow",
                "state": "complete"
              },
              {
                "kind": "fact",
                "fact": "cray.seizure.agreed"
              },
              {
                "kind": "fact",
                "fact": "quell.crate-access"
              },
              {
                "kind": "fact",
                "fact": "cray.bay-nine.suspicion"
              },
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "cut-the-net",
                "state": "complete"
              },
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "open-bay-nine",
                "state": "complete"
              },
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "win-the-brawl",
                "state": "complete"
              },
              {
                "kind": "objectiveState",
                "quest": "quest-crate-for-mr-s",
                "objective": "divert-the-crate",
                "state": "complete"
              }
            ]
          },
          "stage": "plan"
        }
      ]
    },
    {
      "id": "plan",
      "text": "Bay nine has a hoist, a night watchman, a seal stamped by a clerk who has been dead for a year, and a quay door. There are several ways to get a crate out of it and every one of them is a story."
    }
  ],
  "initialStage": "rumour",
  "objectives": [
    {
      "id": "case-the-warehouse",
      "kind": "enterArea",
      "text": "Case the bonded warehouse and find bay nine.",
