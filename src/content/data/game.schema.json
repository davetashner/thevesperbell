{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "const": "game",
      "description": "Always \"game\": there is one game configuration."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What this build offers and why."
    },
    "playableClasses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "description": "A class from src/content/data/class/.",
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "x-contentRef": "class"
      },
      "description": "The classes the class select screen lets the player confirm; the rest show locked (mw-e01.15)."
    },
    "startScene": {
      "description": "The scene a new game starts in and the title screen shows behind it (mw-e01.2).",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "x-contentRef": "scene"
    },
    "clock": {
      "type": "object",
      "properties": {
        "dayLengthRealMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Real minutes of sim time in one game day; 60 means a day passes in an hour."
        },
        "start": {
          "type": "object",
          "properties": {
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Day number a new world starts on."
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439,
              "description": "Minute of that day a new world starts at (360 = 06:00)."
            }
          },
          "required": [
            "day",
            "minute"
          ],
          "additionalProperties": false,
          "description": "Where a new world starts."
        },
        "phases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Phase id, e.g. \"dawn\"."
              },
              "startMinute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1439,
                "description": "Minute of the day the phase begins."
              }
            },
            "required": [
              "id",
              "startMinute"
            ],
            "additionalProperties": false
          },
          "description": "Phases of the day, ascending by startMinute; the last runs past midnight into the first."
        },
        "pauseScreens": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Screen id -> whether it holds the clock while open (the sim already stops while a menu pauses it; this is for screens that leave it running)."
        }
      },
      "required": [
        "dayLengthRealMinutes",
        "start",
        "phases",
        "pauseScreens"
      ],
      "additionalProperties": false,
      "description": "The in-game clock (mw-e27.12)."
    }
  },
  "required": [
    "id",
    "notes",
    "playableClasses",
    "startScene",
    "clock"
  ],
  "additionalProperties": false
}
