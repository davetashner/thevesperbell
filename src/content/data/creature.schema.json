{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique creature id, e.g. \"forgotten-miner\". Stable once shipped (saves)."
    },
    "schemaVersion": {
      "default": 1,
      "description": "CreatureDef schema version, for future migrations.",
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string",
      "enum": [
        "forgotten",
        "rootcellar-goblin",
        "hornfolk",
        "loom-spider",
        "briar-wolf",
        "hushling",
        "tallow-ooze",
        "mimic",
        "hollow-sentinel",
        "wraith",
        "human",
        "animal"
      ],
      "description": "Creature family (story bible §8)."
    },
    "tags": {
      "description": "Free-form tags read by AI and quests, e.g. \"leader\", \"undead\".",
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "health": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum health."
        },
        "poise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum poise; poise damage that empties it staggers the creature (0 = any poise hit)."
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mass in kilograms (knockback, grabs, pressure plates)."
        },
        "size": {
          "type": "string",
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge"
          ],
          "description": "Size class."
        }
      },
      "required": [
        "health",
        "poise",
        "mass",
        "size"
      ],
      "additionalProperties": false,
      "description": "Core stats."
    },
    "senses": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-contentRef": "sense"
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "description": "Sense profile to start from; the other fields override it. Absent = the object is a complete inline profile.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "x-contentRef": "sense"
            },
            "sight": {
              "description": "Sight fields to override; null = blind.",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "nearRange": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres within which a visible target is noticed at the full detection rate."
                    },
                    "farRange": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres beyond which it sees nothing; detection falls off from near."
                    },
                    "primaryHalfAngle": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 180,
                      "description": "Half-angle of the focused (primary) cone, degrees from the facing direction."
                    },
                    "peripheralHalfAngle": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 180,
                      "description": "Half-angle of the peripheral cone, degrees; at least primaryHalfAngle."
                    },
                    "verticalHalfAngle": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 90,
                      "description": "Vertical half-angle above and below eye level, degrees."
                    },
                    "darkVision": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "How well it sees in darkness, 0–1: 0 = needs light, 1 = unaffected."
                    },
                    "detectionSpeed": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Multiplier on how quickly sightings build awareness; 1 = baseline."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "hearing": {
              "description": "Hearing fields to override; null = deaf.",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "thresholdDb": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 140,
                      "description": "Quietest sound it hears, dB at the listener after propagation."
                    },
                    "range": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres beyond which it hears nothing, however loud."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "smell": {
              "description": "Smell fields to override; null = no sense of smell.",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "range": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres it can smell a scent source in still air."
                    },
                    "windSensitive": {
                      "type": "boolean",
                      "description": "Whether wind carries scent to it (downwind smells farther)."
                    },
                    "tracksScentTrails": {
                      "type": "boolean",
                      "description": "Whether it follows scent trails left by moving targets (hook; post-MVP simulation)."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "special": {
              "description": "Special senses to override or add by channel (tremor, life-sense, magic-sense); null removes one.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "range": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Metres the sense reaches."
                      },
                      "minStrength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Weakest signal it registers, 0–1 (after range falloff)."
                      },
                      "requiresLineOfSight": {
                        "type": "boolean",
                        "description": "Whether walls block it (false = senses through walls and floors)."
                      },
                      "requiresMovement": {
                        "type": "boolean",
                        "description": "Whether it only senses targets that are moving."
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "A `sense` profile id; or `{ base, …overrides }` (named fields replace the base’s, null removes a sense or channel); or a complete inline profile (no base)."
    },
    "locomotion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-contentRef": "locomotion"
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "description": "Locomotion profile to start from; the other fields override it. Absent = the object is a complete inline profile.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "x-contentRef": "locomotion"
            },
            "agent": {
              "description": "Agent size fields to override.",
              "type": "object",
              "properties": {
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Nav agent radius, m (clearance from walls)."
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Nav agent height, m (headroom it needs)."
                }
              },
              "additionalProperties": false
            },
            "modes": {
              "description": "Modes to override or add, field by field; a mode the base lacks is given in full.",
              "type": "object",
              "properties": {
                "walk": {
                  "description": "Walking on the navmesh. Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "stepHeight": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Tallest step it walks up without a jump, m; at most agent.height."
                        },
                        "maxSlope": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 90,
                          "description": "Steepest walkable slope, degrees."
                        },
                        "jumpHeight": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Highest ledge it can jump up onto, m (jump links); 0 = never jumps."
                        },
                        "maxDrop": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Highest drop it takes deliberately, m (drop links)."
                        },
                        "wadeDepth": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Deepest water it wades through, m; 0 = keeps out of water."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "climb": {
                  "description": "Climbing surfaces marked `climbable` (climb links). Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "maxGrade": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3,
                          "description": "Hardest climb difficulty it climbs: 1 ladders, ropes and ivy, 2 rough walls, 3 sheer or frozen."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fly": {
                  "description": "Kinematic flight at a height offset; also crosses gaps and water. Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "maxAltitude": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "Highest it flies above the ground below, m (height-offset flight, e11.4)."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "swim": {
                  "description": "Swimming in water too deep to wade. Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "dives": {
                          "type": "boolean",
                          "description": "Whether it swims underwater (false = surface only)."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "burrow": {
                  "description": "Digging through diggable materials (burrow links). Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "materials": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "x-contentRef": "material"
                          },
                          "description": "Material presets it digs through (burrow links), e.g. \"earth\"."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "wallcrawl": {
                  "description": "Crawling on any solid wall, whatever its climbing grade. Fields to override; null = cannot move this way.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "speeds": {
                          "type": "object",
                          "properties": {
                            "sneak": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Sneak speed, m/s (investigate, stalk)."
                            },
                            "walk": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Walk speed, m/s (patrol, idle); at least sneak."
                            },
                            "run": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "description": "Run speed, m/s (chase, combat, flee); at least walk."
                            }
                          },
                          "additionalProperties": false,
                          "description": "Gait speeds to override, m/s."
                        },
                        "ceilings": {
                          "type": "boolean",
                          "description": "Whether it also crawls upside down across ceilings."
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stationary": {
                  "description": "Never moves; must be its only mode. null removes it.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "squeezes": {
              "description": "Overrides whether it fits through crawlspaces.",
              "type": "boolean"
            },
            "opensDoors": {
              "description": "Overrides whether it opens unlocked doors.",
              "type": "boolean"
            },
            "areaCosts": {
              "description": "Area costs to override (ground, water-shallow, water-deep, crawlspace); null resets one to 1.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "ground",
                  "water-shallow",
                  "water-deep",
                  "crawlspace"
                ]
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 100,
                    "description": "Path-cost multiplier, 0.1–100: below 1 prefers the area, above 1 avoids it."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "A `locomotion` profile id; or `{ base, …overrides }` (named fields replace the base’s, null removes a mode or area cost); or a complete inline profile (no base)."
    },
    "attacks": {
      "description": "Attack ids it can use (attack content, e12.5); none = it never attacks.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "x-contentRef": "attack"
      }
    },
    "regions": {
      "description": "Hit regions beyond the body (mw-e05.6): head, weak points, armoured plates. Shapes come with the rig.",
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Hurtbox id, unique within the creature, e.g. \"core\"."
          },
          "region": {
            "type": "string",
            "enum": [
              "weakpoint",
              "head",
              "torso",
              "limb"
            ],
            "description": "Region it counts as: head ×2, weakpoint ×3, …"
          },
          "multiplier": {
            "description": "Damage multiplier; absent = the region default (weakpoint 3, head 2, else 1).",
            "type": "number",
            "minimum": 0
          },
          "armor": {
            "description": "Armour value: arrows with less penetration ricochet off it for 0 damage.",
            "type": "number",
            "minimum": 0
          },
          "enabledIn": {
            "description": "Weakpoints only (required for them): the creature states it is enabled in, e.g. [\"roaring\"]; outside them a hit resolves against `underlying`.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "underlying": {
            "description": "Region a disabled weakpoint resolves as; absent = torso.",
            "type": "string",
            "enum": [
              "head",
              "torso",
              "limb"
            ]
          }
        },
        "required": [
          "id",
          "region"
        ],
        "additionalProperties": false
      }
    },
    "properties": {
      "description": "World properties of its body (e03, mw-e03.24): the same ones objects have, so it burns, soaks, freezes and conducts by the same rules. Omitted ones take the flesh material's, then the actor defaults (flammable, ignites at 450 °C, burns 6 s).",
      "default": {},
      "type": "object",
      "properties": {
        "material": {
          "description": "Material preset id (a material content entry).",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-contentRef": "material"
        },
        "temperature": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Current temperature, °C."
        },
        "flammable": {
          "type": "boolean",
          "description": "Fire can ignite it."
        },
        "ignitionPoint": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Temperature at which it ignites, °C."
        },
        "fuel": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400,
          "description": "Seconds of burning left."
        },
        "burning": {
          "type": "boolean",
          "description": "On fire right now."
        },
        "wetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How soaked it is (dry … saturated), 0 … 1."
        },
        "absorbency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The most wetness it can hold (nothing soaks in … fully absorbent); water raises wetness no higher, 0 … 1."
        },
        "frozen": {
          "type": "boolean",
          "description": "Frozen solid."
        },
        "freezePoint": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Temperature at or below which it freezes, °C."
        },
        "conductive": {
          "type": "boolean",
          "description": "Conducts electric charge."
        },
        "charge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Stored electric charge."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Mass, kg."
        },
        "fragile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Impact energy that breaks it, J."
        },
        "hp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Structural hit points."
        },
        "density": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000,
          "description": "Density, kg/m³; below 1000 it floats in water."
        },
        "climbable": {
          "type": "string",
          "enum": [
            "none",
            "ladder",
            "rope",
            "ivy",
            "rough",
            "sheer"
          ],
          "description": "Climbing grade: none, ladder, rope, ivy (easy), rough (needs a climber), sheer (needs a tool)."
        },
        "liftable": {
          "type": "boolean",
          "description": "Can be picked up and carried."
        },
        "pushable": {
          "type": "boolean",
          "description": "Can be pushed or dragged."
        },
        "remoteActuatable": {
          "type": "boolean",
          "description": "Can be operated from a distance by magic (remote actuation)."
        },
        "hideable": {
          "type": "boolean",
          "description": "An actor can hide in or behind it."
        },
        "reflective": {
          "type": "boolean",
          "description": "Reflects light beams and bolts."
        },
        "transparent": {
          "type": "boolean",
          "description": "Light and sight pass through it."
        },
        "opaque": {
          "type": "boolean",
          "description": "Fully blocks light and sight."
        },
        "lightEmitter": {
          "type": "object",
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "description": "Light output (a torch is about 100)."
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Reach, m."
            }
          },
          "required": [
            "intensity",
            "radius"
          ],
          "additionalProperties": false,
          "description": "Emits light."
        },
        "soundDamping": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of sound it absorbs, 0 … 1."
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Surface friction coefficient."
        },
        "impactAbsorb": {
          "type": "number",
          "minimum": 0,
