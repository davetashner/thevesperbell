          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Force of one gust, blast or kick that blows its flame out, N·s."
        },
        "flameRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
