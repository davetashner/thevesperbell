          "type": "boolean",
          "description": "Hangs from its support; falls when the support breaks, burns or is cut."
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Entity a suspended object hangs from (0 = none); set when the level spawns."
        },
        "breakable": {
          "type": "boolean",
          "description": "A single hit at or above its toughness for that kind of hit breaks it."
        },
        "toughness": {
          "type": "object",
          "properties": {
            "blunt": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Blunt hit energy that breaks it, J."
            },
            "slash": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Slash hit energy that breaks it, J."
            },
            "pierce": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Pierce hit energy that breaks it, J."
            },
            "force": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Force (blast, quake, boulder) energy that breaks it, J."
            }
          },
          "additionalProperties": false,
          "description": "Per kind of hit, the single-hit energy that breaks a breakable object; a kind left out never does."
        },
        "bashable": {
          "type": "boolean",
          "description": "A shield bash or kick shoves it (or breaks it when breakable)."
        },
        "cuttable": {
          "type": "boolean",
          "description": "Slash or pierce damage severs it."
        },
        "shootable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Projectile impulse that fires its signal, N·s."
        },
        "softAnchor": {
          "type": "boolean",
          "description": "Rope arrows and hooks embed in it."
        },
        "surfaceHardness": {
          "type": "string",
          "enum": [
            "soft",
            "medium",
            "hard"
          ],
