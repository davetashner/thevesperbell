        "chargeActivated": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Stored charge at which the mechanism fires."
        },
        "lightActivated": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Light level on it at which the mechanism fires."
        },
        "hidden": {
          "type": "boolean",
          "description": "Not perceivable or targetable until revealed."
