{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique merchant id, e.g. \"briar-glen-general-store\". Stable once shipped."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "Who runs it and why these prices and stock, for owner review."
    },
    "npcId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The NPC who speaks for the shop (dialogue speaker id)."
    },
    "displayName": {
      "description": "The keeper’s name as the shop window shows it, e.g. \"Ottilie Marsh\"; absent = the NPC id made readable.",
      "type": "string",
      "minLength": 1
    },
    "shopName": {
      "description": "The shop’s name, e.g. \"Brand’s Forge\" (signage, shop window subtitle).",
      "type": "string",
      "minLength": 1
    },
    "personalityTags": {
      "default": [],
      "description": "Personality traits that colour barks and haggling.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "greedy",
          "gossipy",
          "suspicious",
          "generous",
          "gruff",
          "friendly",
          "shrewd",
          "nervous"
        ]
      }
    },
    "specialties": {
      "default": [],
      "description": "Item categories bought at a better rate (`specialtyBonus`); must be bought categories.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "armor",
          "shield",
          "ammo",
          "book",
          "key",
          "consumable",
          "tool",
          "quest",
          "artifact",
          "currency",
          "misc"
        ]
      }
    },
    "buysCategories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "armor",
          "shield",
          "ammo",
          "book",
          "key",
          "consumable",
          "tool",
          "quest",
          "artifact",
          "currency",
          "misc"
        ]
      },
      "description": "Item categories the merchant buys from the player."
    },
    "stock": {
      "description": "What the merchant sells.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "description": "An item the merchant stocks.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "item"
          },
          "lootTable": {
            "description": "A loot table rolled to stock the shelf (a shop that varies).",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "loot-table"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "description": "Units of the item, or rolls of the loot table."
          },
          "restock": {
            "description": "How the stock refills; absent = never restocks (a unique good never returns once sold). Runs on world-day ticks: `amount` every `everyHours` rounded up to whole days, up to `count`. A loot-table entry with a rule rotates instead: its unsold units are replaced by `count` fresh rolls each period.",
            "type": "object",
            "properties": {
              "everyHours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 720,
                "description": "In-world hours between restocks."
              },
              "amount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999,
                "description": "Units (or rolls) added each time, up to `count`."
              }
            },
            "required": [
              "everyHours",
              "amount"
            ],
            "additionalProperties": false
          },
          "when": {
            "description": "A world-fact condition (mw-e27.5): the entry is absent until it holds, appears at the next restock and stays.",
            "$ref": "#/$defs/condition"
          }
        },
        "required": [
          "count"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "default": [],
      "description": "Services on the shop window’s Services tab (an inn’s rooms).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Service id, unique within the merchant, e.g. \"room-for-the-night\"."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "What the shop window lists, e.g. \"Room for the night\"."
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Crowns, fixed by the merchant: no markup, disposition or haggle applies. A `rest` service sits in the inn-bed band 8-15."
          },
          "kind": {
            "type": "string",
            "enum": [
              "rest",
              "train"
            ],
            "description": "`rest`: sleep until morning, fully healed (the Sleeping Ox room). `train`: a lesson that teaches `teaches` (mw-ju8.13)."
          },
          "teaches": {
            "description": "The capability a `train` service teaches; required for `train`, absent otherwise.",
            "type": "string",
            "pattern": "^(verb|spell|arrow|tool|trick|technique|sense)\\.[a-z0-9.-]+$"
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "goldReserve": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Gold the merchant starts with to pay the player for sales."
    },
    "goldRestockPerDay": {
      "default": 0,
      "description": "Gold the reserve refills by each in-world day, up to `goldReserve`.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "markup": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Multiplier on item value when the player buys (economy band 1.1-1.5)."
    },
    "buyRate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Fraction of item value paid when the player sells (band 0.3-0.6)."
    },
    "specialtyBonus": {
      "description": "Extra multiplier on the buy rate for specialties (band 1.1-1.3); default 1.2.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "isFence": {
      "default": false,
      "description": "A fence deals in stolen goods.",
      "type": "boolean"
    },
    "buysStolen": {
      "default": false,
      "description": "Buys stolen goods; only a fence (`isFence`) may.",
      "type": "boolean"
    },
    "stolenFactor": {
      "description": "Multiplier on the price of stolen goods (band 0.5-0.8); default 0.6.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hours": {
      "description": "Opening hours (world-time hook); absent = always open.",
      "type": "object",
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Hour of day (0-23) the shop opens."
        },
        "close": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "description": "Hour of day (0-23) it closes; may be earlier than open (overnight)."
        }
      },
      "required": [
        "open",
        "close"
      ],
      "additionalProperties": false
    },
    "barkSet": {
      "description": "Bark set id for the shopkeeper’s lines (E22).",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "id",
    "notes",
    "npcId",
    "buysCategories",
    "goldReserve",
    "markup",
    "buyRate"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "A condition over world facts and live state: one of fact, count, entities, signal, sustained, all, any, not (docs/design/conditions.md).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "description": "Fact key to test. Alone: the (bool) fact is true. With one operator: that comparison holds."
            },
            "eq": {
              "description": "The fact equals this value.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "neq": {
              "description": "The fact does not equal this value (unset counts as unequal).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gt": {
              "description": "The (int or tick) fact is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The (int or tick) fact is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The (int or tick) fact is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The (int or tick) fact is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "has": {
              "description": "true: the fact holds a value (set, or declared with a non-null default); false: none.",
              "type": "boolean"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "Tests one fact, with at most one operator."
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "pattern": "^entity:([a-z0-9]+(?:-[a-z0-9]+)*|\\*)\\/\\*\\.([a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*)$",
              "description": "Entity facts to count: `entity:<level>/*.<fact>` (one level) or `entity:*/*.<fact>` (every level). Counts those holding true."
            },
            "eq": {
              "description": "The count equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The count does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The count is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The count is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The count is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The count is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "description": "Counts true entity facts matching a pattern, compared with exactly one operator."
        },
        {
          "type": "object",
          "properties": {
            "entities": {
              "type": "object",
              "properties": {
                "tag": {
                  "description": "Entities carrying this tag (an entity tag, or the tag of a scene spawn).",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "entity": {
                  "description": "The entity of the scene spawn with this id.",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "additionalProperties": false,
              "description": "Which entities to test. `{ \"tag\": … }`, `{ \"entity\": … }` or both; `{}` is every entity with a placement."
            },
            "where": {
              "description": "Predicates (property, tag, element) an entity must all pass.",
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "property"
                      },
                      "property": {
                        "type": "string",
                        "enum": [
                          "material",
                          "temperature",
                          "flammable",
                          "ignitionPoint",
                          "fuel",
                          "burning",
                          "wetness",
                          "absorbency",
                          "frozen",
                          "freezePoint",
                          "conductive",
                          "charge",
                          "weight",
                          "fragile",
                          "hp",
                          "density",
                          "climbable",
                          "liftable",
                          "pushable",
                          "remoteActuatable",
                          "hideable",
                          "reflective",
                          "transparent",
                          "opaque",
                          "soundDamping",
                          "friction",
                          "impactAbsorb",
                          "owner",
                          "liquid",
                          "flammableGas",
                          "extinguishable",
                          "windResistance",
                          "flameRadius",
                          "waterSurface",
                          "unstable",
                          "suspended",
                          "support",
                          "breakable",
                          "bashable",
                          "cuttable",
                          "shootable",
                          "softAnchor",
                          "surfaceHardness",
                          "chargeActivated",
                          "lightActivated",
                          "hidden",
                          "trapped",
                          "trap",
                          "container",
                          "remains",
                          "noiseMultiplier"
                        ],
                        "description": "World property to compare (absent = its default)."
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "ne",
                          "lt",
                          "lte",
                          "gt",
                          "gte"
                        ],
                        "description": "Comparison; lt/lte/gt/gte need a number property."
                      },
                      "value": {
                        "description": "Value to compare with.",
                        "type": [
                          "number",
                          "boolean",
                          "string"
                        ]
                      }
                    },
                    "required": [
                      "test",
                      "property",
                      "op",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "tag"
                      },
                      "tag": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "description": "Tag the entity must carry, e.g. \"player\"."
                      }
                    },
                    "required": [
                      "test",
                      "tag"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "const": "element"
                      },
                      "element": {
                        "type": "string",
                        "enum": [
                          "fire",
                          "water",
                          "ice",
                          "charge"
                        ],
                        "description": "fire = burning, water = wetness > 0, ice = frozen, charge = charge > 0."
                      }
                    },
                    "required": [
                      "test",
                      "element"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "One condition; every condition of a filter must hold."
              }
            },
            "inside": {
              "description": "The entity must stand in this box, sphere or capsule, in world coordinates.",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "box",
                      "description": "Shape: an axis-aligned box."
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Centre of the box, metres."
                    },
                    "halfExtents": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Half the size per axis."
                    }
                  },
                  "required": [
                    "kind",
                    "center",
                    "halfExtents"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "sphere",
                      "description": "Shape: a sphere."
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "Centre of the sphere, metres."
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres."
                    }
                  },
                  "required": [
                    "kind",
                    "center",
                    "radius"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "capsule",
                      "description": "Shape: a capsule, a segment swept by a radius."
                    },
                    "from": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "One end of the capsule’s segment, metres."
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "y": {
                          "type": "number",
                          "description": "Metres."
                        },
                        "z": {
                          "type": "number",
                          "description": "Metres."
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "z"
                      ],
                      "additionalProperties": false,
                      "description": "The other end of the capsule’s segment, metres."
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Metres."
                    }
                  },
                  "required": [
                    "kind",
                    "from",
                    "to",
                    "radius"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "match": {
              "description": "all: at least one entity is selected and every one passes; any: one passes; none: none passes.",
              "type": "string",
              "enum": [
                "all",
                "any",
                "none"
              ]
            },
            "eq": {
              "description": "The number of entities that pass equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The number that pass does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The number that pass is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "At least this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "Fewer than this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "At most this many pass.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "entities"
          ],
          "additionalProperties": false,
          "description": "Property predicates over live entities: how many of them pass, and where they are. Exactly one of match or an operator."
        },
        {
          "type": "object",
          "properties": {
            "signal": {
              "type": "string",
              "pattern": "^([a-z0-9]+(?:-[a-z0-9]+)*)\\/([a-z0-9]+(?:-[a-z0-9]+)*)$",
              "description": "Signal graph id and node id, e.g. \"vault/gate-open\". Holds while the output is on."
            },
            "port": {
              "description": "Output port of the node; default: its first.",
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "signal"
          ],
          "additionalProperties": false,
          "description": "True while a signal graph node output is on (mark the node `observed`)."
        },
        {
          "type": "object",
          "properties": {
            "sustained": {
              "description": "The condition that must keep holding.",
              "$ref": "#/$defs/condition"
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600,
              "description": "Seconds of sim time it must hold, without a break."
            }
          },
          "required": [
            "sustained",
            "seconds"
          ],
          "additionalProperties": false,
          "description": "True once the condition has held, without a break, for that long."
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "Every condition holds."
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "True when every condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
